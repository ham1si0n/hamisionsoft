	local function CreateDashedBorder(parent, zBase, offsetX, offsetY)
		offsetX = offsetX or -2; offsetY = offsetY or -2
		local dashContainer=Instance.new("Frame"); dashContainer.Name="DashBorder"
		dashContainer.Size=UDim2.new(1, -offsetX*2, 1, -offsetY*2)
		dashContainer.Position=UDim2.new(0, offsetX, 0, offsetY)
		dashContainer.BackgroundTransparency=1; dashContainer.BorderSizePixel=0
		dashContainer.ZIndex=zBase+3; dashContainer.ClipsDescendants=false; dashContainer.Parent=parent
		local dashes={}; local dashLen=8; local gapLen=5; local thick=2
		for i=0,50 do
			local d=Instance.new("Frame"); d.Size=UDim2.new(0,dashLen,0,thick); d.Position=UDim2.new(0,i*(dashLen+gapLen),0,-1)
			d.BackgroundColor3=C.DashColor; d.BackgroundTransparency=0.3; d.BorderSizePixel=0; d.ZIndex=zBase+4; d.Parent=dashContainer; table.insert(dashes,d)
		end
		for i=0,50 do
			local d=Instance.new("Frame"); d.Size=UDim2.new(0,dashLen,0,thick); d.Position=UDim2.new(0,i*(dashLen+gapLen),1,-1)
			d.BackgroundColor3=C.DashColor; d.BackgroundTransparency=0.3; d.BorderSizePixel=0; d.ZIndex=zBase+4; d.Parent=dashContainer; table.insert(dashes,d)
		end
		for i=0,50 do
			local d=Instance.new("Frame"); d.Size=UDim2.new(0,thick,0,dashLen); d.Position=UDim2.new(0,-1,0,i*(dashLen+gapLen))
			d.BackgroundColor3=C.DashColor; d.BackgroundTransparency=0.3; d.BorderSizePixel=0; d.ZIndex=zBase+4; d.Parent=dashContainer; table.insert(dashes,d)
		end
		for i=0,50 do
			local d=Instance.new("Frame"); d.Size=UDim2.new(0,thick,0,dashLen); d.Position=UDim2.new(1,-1,0,i*(dashLen+gapLen))
			d.BackgroundColor3=C.DashColor; d.BackgroundTransparency=0.3; d.BorderSizePixel=0; d.ZIndex=zBase+4; d.Parent=dashContainer; table.insert(dashes,d)
		end
		task.spawn(function()
			while State.guiOpen and dashContainer and dashContainer.Parent do
				for _,d in ipairs(dashes) do
					if d and d.Parent then
						local nt = 0.2 + 0.3 * math.sin(tick() * 1.5 + d.Position.X.Offset)
						TweenService:Create(d, TweenInfo.new(0.8), {BackgroundTransparency = nt}):Play()
					end
				end
				task.wait(1.5)
			end
		end)
		return dashContainer, dashes
	end

