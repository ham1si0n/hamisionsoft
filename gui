			for _,obj in pairs(ESP.objects) do
				if obj.boxFrame and obj.boxFrame.Parent then
					if ESP.settings.boxStyle == "Outline" then
						for _,ch in pairs(obj.boxFrame:GetChildren()) do if ch:IsA("Frame") and ch.Name=="BoxLine" then ch.BackgroundColor3=col end end
					elseif ESP.settings.boxStyle == "Filled" then
						local fill = obj.boxFrame:FindFirstChildOfClass("Frame"); if fill then fill.BackgroundColor3 = col end
					elseif ESP.settings.boxStyle == "Corner" then
						if obj.cornerRefs then
							for _,c in ipairs(obj.cornerRefs) do if c.frame and c.frame.Parent then c.frame.BackgroundColor3=col end end
						end
					end
				end
				if obj.nameLabel and obj.nameLabel.Parent then obj.nameLabel.TextColor3=col end
				if obj.glow and obj.glow.Parent then obj.glow.FillColor=col; obj.glow.OutlineColor=col end
				if obj.tracerLine then pcall(function() obj.tracerLine.Color=col end) end
				if obj.skeleton then for _, line in pairs(obj.skeleton) do pcall(function() line.Color = col end) end end
			end
			for _,hl in pairs(ESP.chamsObjects) do
				if hl and hl.Parent then pcall(function() hl.FillColor=col; hl.OutlineColor=col end) end
			end
			for _,ind in ipairs(esp360Active) do
				if ind and ind.Parent then ind.BackgroundColor3 = col end
			end
		end
		task.wait(0.05)
	end end)
