		State.annoyEnabled=false; State.annoyTarget=nil; State.nightEnabled=false
		State.attachBehindEnabled=false; State.attachHeadEnabled=false; State.attachFeetEnabled=false; State.viewEnabled=false
		Aimbot.enabled=false; Aimbot.locked=nil; Crosshair.enabled=false
		State.skeletonESPEnabled=false; State.espGlowEnabled=false
		State.telekillEnabled=false; State.telekillTarget=nil
		State.autoSpeedEnabled=false; State.fakeLagEnabled=false
