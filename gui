local function FormatRelTime(ts)
	if not ts then return "no metadata" end
	local diff = os.time() - ts
	if diff < 0 then return "just now" end
	if diff < 60 then return "just now"
	elseif diff < 3600 then return math.floor(diff/60).."m ago"
	elseif diff < 86400 then return math.floor(diff/3600).."h ago"
	else return math.floor(diff/86400).."d ago" end
end

function ConfigSystem.ProfilePath(name) return CONFIG_FOLDER.."/"..name..".json" end

function ConfigSystem.GetProfileMeta(name)
	if not hasFileSystem then return nil end
	local path = ConfigSystem.ProfilePath(name)
	if not isfile(path) then return nil end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if not ok or type(data) ~= "table" then return nil end
	return data._meta
end

