	end

	local function GetOrCreateESP360Indicator()
		local ind = table.remove(esp360Pool)
		if ind and ind.Parent then return ind end
		ind = Instance.new("Frame")
		ind.Size = UDim2.new(0, 10, 0, 10)
		ind.AnchorPoint = Vector2.new(0.5, 0.5)
		ind.BackgroundColor3 = ESP.settings.boxColor
		ind.BackgroundTransparency = 0.25
		ind.BorderSizePixel = 0
		ind.ZIndex = 51
		ind.Visible = false
		ind.Parent = esp360Container
		Instance.new("UICorner", ind).CornerRadius = UDim.new(1,0)
		local stroke = Instance.new("UIStroke", ind)
		stroke.Thickness = 1.5
		stroke.Color = Color3.fromRGB(0,0,0)
		stroke.Transparency = 0.4
		return ind
	end

	function UpdateESP360()
		if not State.esp360Enabled or not State.espEnabled then
			if esp360Container then esp360Container.Visible = false end
			for _, ind in ipairs(esp360Active) do table.insert(esp360Pool, ind) end
			esp360Active = {}
			return
		end
		if not esp360Container or not esp360Container.Parent then SetupESP360() end
		esp360Container.Visible = true

		for _, ind in ipairs(esp360Active) do table.insert(esp360Pool, ind) end
		esp360Active = {}

		local vp = camera.ViewportSize
		local center = Vector2.new(vp.X/2, vp.Y/2 + topbarInsetY*0.5)
		local radius = math.min(vp.X, vp.Y) * 0.42
		local camCF = camera.CFrame
		local camPos = camCF.Position
		local camRight = camCF.RightVector
		local camUp = camCF.UpVector
		local camLook = camCF.LookVector

		for _, target in pairs(Players:GetPlayers()) do
			if target ~= player and not (ESP.settings.teamCheck and target.Team == player.Team and player.Team ~= nil) then
				local char = target.Character
				if char then
					local h2 = char:FindFirstChild("Humanoid")
					local r2 = char:FindFirstChild("HumanoidRootPart")
					if h2 and h2.Health > 0 and r2 then
						local screenPos, onScreen = camera:WorldToViewportPoint(r2.Position)
						local worldDelta = r2.Position - camPos
						local dotLook = worldDelta:Dot(camLook)

						if not (onScreen and dotLook > 0 and screenPos.Z > 0) then
							local dist = worldDelta.Magnitude
							if dist > 0.001 then
								local dir = worldDelta / dist
								local dotRight = dir:Dot(camRight)
								local dotUp = dir:Dot(camUp)

								if dotLook < 0 then
									dotRight = -dotRight
									dotUp = -dotUp
								end

								local angle = math.atan2(dotUp, dotRight)
								local x = center.X + math.cos(angle) * radius
								local y = center.Y - math.sin(angle) * radius

								local ind = GetOrCreateESP360Indicator()
								ind.Position = UDim2.fromOffset(x, y)
								ind.BackgroundColor3 = ESP.settings.boxColor
								ind.Visible = true
								table.insert(esp360Active, ind)
							end
						end
					end
				end
			end
		end
	end

	function CreateESP(target)
		if target==player then return end; RemoveESP(target)
		local char=target.Character; if not char then return end
		local r2=char:FindFirstChild("HumanoidRootPart"); local h2=char:FindFirstChild("Humanoid"); local head=char:FindFirstChild("Head")
		if not r2 or not h2 or not head then return end
		local s=ESP.settings
		if s.teamCheck and target.Team==player.Team and player.Team~=nil then return end
		if h2.Health<=0 then return end
		ESP.connections[target]={}
		table.insert(ESP.connections[target],h2.Died:Connect(function() task.delay(0.5,function() RemoveESP(target) end) end))
