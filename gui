do
	function StartFakeLag()
		if State.fakeLagConnection then return end
		if humanoid then State.fakeLagOriginalSpeed = humanoid.WalkSpeed end
		State.fakeLagTimer = 0
		State.fakeLagConnection = RunService.Heartbeat:Connect(function(dt)
			if not State.fakeLagEnabled or not humanoid or not humanoid.Parent then return end
			State.fakeLagTimer = (State.fakeLagTimer or 0) + dt
			if State.fakeLagTimer >= 0.3 then
				humanoid.WalkSpeed = 0
				task.delay(0.1, function()
					if humanoid and humanoid.Parent and State.fakeLagEnabled then
						humanoid.WalkSpeed = State.fakeLagOriginalSpeed or State.speedValue
					end
				end)
				State.fakeLagTimer = 0
			end
		end)
	end
	function StopFakeLag()
		if State.fakeLagConnection then State.fakeLagConnection:Disconnect(); State.fakeLagConnection = nil end
		if humanoid and humanoid.Parent then humanoid.WalkSpeed = State.fakeLagOriginalSpeed or State.speedValue end
		State.fakeLagTimer = nil
	end
	function ToggleFakeLag(enabled)
		State.fakeLagEnabled = enabled
		if enabled then StartFakeLag() else StopFakeLag() end
	end
end

-- ================= BLOCK: CAMERA NOCLIP =================
do
	local function ReleaseCamMouseLock()
		if State.camNoclipMouseLocked then
			State.camNoclipMouseLocked = false
			pcall(function()
				if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCurrentPosition
				or UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
					UserInputService.MouseBehavior = Enum.MouseBehavior.Default
				end
			end)
			ApplyCursorVisibility()
		end
	end

	local function IsMouseOverMenu()
		local loc = UserInputService:GetMouseLocation()
		local function inside(c)
			if not c or not c.Visible or not c.Parent then return false end
			local ap = c.AbsolutePosition
			local as = c.AbsoluteSize
			return loc.X >= ap.X and loc.X <= ap.X+as.X and loc.Y >= ap.Y and loc.Y <= ap.Y+as.Y
		end
		if inside(MainContainer) then return true end
		if inside(GUI.playersContainer) then return true end
		if inside(GUI.flyContainer) then return true end
		for _, sm in ipairs(GUI.allSubMenus) do
			if inside(sm.container) then return true end
		end
		return false
	end

	-- Первое лицо: либо игра в LockFirstPerson, либо мы вплотную (zoom <= 2.5)
	local function IsFirstPersonView()
		if player.CameraMode == Enum.CameraMode.LockFirstPerson then return true end
		if State.camNoclipZoom <= 2.5 then return true end
		return false
	end

	-- LocalTransparencyModifier = 1 скрывает части персонажа ТОЛЬКО для локального игрока.
	-- Оригинальные значения сохраняются в State.camNoclipSavedTransparency и восстанавливаются.
	local function HideCharacterLocal()
		if State.camNoclipSavedTransparency then return end
		local ch = player.Character
		if not ch then return end
		State.camNoclipSavedTransparency = {}
		for _, part in ipairs(ch:GetDescendants()) do
			if part:IsA("BasePart") then
				State.camNoclipSavedTransparency[part] = part.LocalTransparencyModifier
				part.LocalTransparencyModifier = 1
			end
		end
	end

	local function ShowCharacterLocal()
		if not State.camNoclipSavedTransparency then return end
		for part, orig in pairs(State.camNoclipSavedTransparency) do
			if part and part.Parent then
				pcall(function() part.LocalTransparencyModifier = orig end)
			end
		end
		State.camNoclipSavedTransparency = nil
	end

	function StartCameraNoclip()
		if State.camNoclipConn then return end
		if not camera then return end
		local look = camera.CFrame.LookVector
		State.camNoclipYaw = math.deg(math.atan2(-look.X, -look.Z))
		State.camNoclipPitch = math.deg(math.asin(math.clamp(look.Y, -1, 1)))
		camera.CameraType = Enum.CameraType.Scriptable
		State.camNoclipConn = RunService.RenderStepped:Connect(function(dt)
			if not State.cameraNoclipEnabled then return end
			if not rootPart or not rootPart.Parent then return end

			local firstPerson = IsFirstPersonView()
			local rmbHeld = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
			local shouldLook = firstPerson or rmbHeld

			if shouldLook then
				if not State.camNoclipMouseLocked then
					State.camNoclipMouseLocked = true
					pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition end)
					pcall(function() UserInputService.MouseIconEnabled = false end)
					if cursorFrame then cursorFrame.Visible = false end
				end
				local delta = UserInputService:GetMouseDelta()
				if delta.Magnitude > 0 then
					State.camNoclipYaw = State.camNoclipYaw - delta.X * State.camNoclipSens
					State.camNoclipPitch = math.clamp(State.camNoclipPitch - delta.Y * State.camNoclipSens, -85, 85)
				end
			else
				if State.camNoclipMouseLocked then
					ReleaseCamMouseLock()
				end
			end

			local focus = rootPart.Position + Vector3.new(0, 1.5, 0)
			local rot = CFrame.fromEulerAnglesYXZ(math.rad(State.camNoclipPitch), math.rad(State.camNoclipYaw), 0)
			if firstPerson then
				-- Камера в голове + прячем тело локально
				HideCharacterLocal()
				camera.CFrame = CFrame.new(focus) * rot
			else
				ShowCharacterLocal()
				local offset = rot:VectorToWorldSpace(Vector3.new(0, 0, State.camNoclipZoom))
				camera.CFrame = CFrame.new(focus + offset, focus)
			end
		end)
	end

	function StopCameraNoclip()
		if State.camNoclipConn then State.camNoclipConn:Disconnect(); State.camNoclipConn = nil end
		ReleaseCamMouseLock()
		ShowCharacterLocal()
		if camera then
			camera.CameraType = Enum.CameraType.Custom
			if humanoid and humanoid.Parent then camera.CameraSubject = humanoid end
		end
		ApplyCursorVisibility()
	end

	UserInputService.InputChanged:Connect(function(input)
		if State.cameraNoclipEnabled and input.UserInputType == Enum.UserInputType.MouseWheel then
			if not IsMouseOverMenu() then
				State.camNoclipZoom = math.clamp(State.camNoclipZoom - input.Position.Z * 5, 0.1, 150)
			end
		end
	end)
end

-- ================= BLOCK: CROSSHAIR INTERNALS =================
do
	local function MakeGUILine(x1,y1,x2,y2,color,thickness,transparency)
		local f=Instance.new("Frame"); f.BackgroundColor3=color; f.BackgroundTransparency=transparency or 0; f.BorderSizePixel=0; f.ZIndex=1001
		local dx,dy=x2-x1,y2-y1; local len=math.sqrt(dx*dx+dy*dy)
		f.Size=UDim2.new(0,math.max(len,thickness),0,thickness); f.Position=UDim2.new(0,(x1+x2)/2-math.max(len,thickness)/2,0,(y1+y2)/2-thickness/2)
		f.Rotation=math.deg(math.atan2(dy,dx)); f.Parent=CHContainer; return f
	end
	local function MakeGUICircle(cx,cy,radius,color,thickness,filled,transparency)
		if filled then
			local f=Instance.new("Frame"); f.Size=UDim2.new(0,radius*2,0,radius*2); f.Position=UDim2.new(0,cx-radius,0,cy-radius)
			f.BackgroundColor3=color; f.BackgroundTransparency=transparency or 0; f.BorderSizePixel=0; f.ZIndex=1001
			Instance.new("UICorner",f).CornerRadius=UDim.new(1,0); f.Parent=CHContainer; return f
		else
			local frames={}; local segs=math.max(20,math.floor(radius*1.2))
			for i=0,segs-1 do
				local a1,a2=(i/segs)*math.pi*2,((i+1)/segs)*math.pi*2
				table.insert(frames,MakeGUILine(cx+math.cos(a1)*radius,cy+math.sin(a1)*radius,cx+math.cos(a2)*radius,cy+math.sin(a2)*radius,color,thickness,transparency))
			end
			return frames
		end
	end
	local function CreatePropeller()
		if Crosshair.propFrame and Crosshair.propFrame.Parent then Crosshair.propFrame:Destroy(); Crosshair.propFrame=nil; Crosshair.propBlades={} end
		if not Crosshair.enabled then return end
		local vp=camera.ViewportSize; local cx,cy=vp.X/2,vp.Y/2; local sz=Crosshair.size; local th=Crosshair.thick
		local col=Crosshair.color; local tr=1-Crosshair.opacity; local armLen=sz*4; local hookLen=sz*2; local halfW=armLen+hookLen+th*2
		local pivot=Instance.new("Frame"); pivot.Name="PropellerPivot"; pivot.Size=UDim2.new(0,halfW*2,0,halfW*2)
		pivot.Position=UDim2.new(0,cx-halfW,0,cy-halfW); pivot.BackgroundTransparency=1; pivot.BorderSizePixel=0; pivot.ZIndex=1001; pivot.ClipsDescendants=false; pivot.Parent=CHContainer
		local function MS(x1,y1,x2,y2,isO)
			local f=Instance.new("Frame"); local ax1,ay1,ax2,ay2=halfW+x1,halfW+y1,halfW+x2,halfW+y2
			local ddx,ddy=ax2-ax1,ay2-ay1; local l=math.sqrt(ddx*ddx+ddy*ddy)
			f.Size=UDim2.new(0,math.max(l,1),0,isO and(th+2)or th)
			f.Position=UDim2.new(0,(ax1+ax2)/2-math.max(l,1)/2,0,(ay1+ay2)/2-(isO and(th+2)or th)/2)
			f.Rotation=math.deg(math.atan2(ddy,ddx)); f.BackgroundColor3=isO and Color3.fromRGB(0,0,0)or col
			f.BackgroundTransparency=tr; f.BorderSizePixel=0; f.ZIndex=isO and 1001 or 1002; f.Parent=pivot; return f
		end
		local segs={{0,0,0,-armLen},{0,-armLen,hookLen,-armLen},{0,0,armLen,0},{armLen,0,armLen,hookLen},
			{0,0,0,armLen},{0,armLen,-hookLen,armLen},{0,0,-armLen,0},{-armLen,0,-armLen,-hookLen}}
		for _,s in ipairs(segs) do
			if Crosshair.outline then table.insert(Crosshair.propBlades,MS(s[1],s[2],s[3],s[4],true)) end
			table.insert(Crosshair.propBlades,MS(s[1],s[2],s[3],s[4],false))
		end
		local dot=Instance.new("Frame"); dot.Size=UDim2.new(0,th*2,0,th*2); dot.Position=UDim2.new(0,halfW-th,0,halfW-th)
		dot.BackgroundColor3=col; dot.BackgroundTransparency=tr; dot.BorderSizePixel=0; dot.ZIndex=1003
		Instance.new("UICorner",dot).CornerRadius=UDim.new(1,0); dot.Parent=pivot; table.insert(Crosshair.propBlades,dot); Crosshair.propFrame=pivot
	end
	local function UpdatePropellerColors()
		if not Crosshair.propFrame then return end
		local col=Crosshair.color; local tr=1-Crosshair.opacity
		for _,b in ipairs(Crosshair.propBlades) do if b and b.Parent then
			if b.BackgroundColor3~=Color3.fromRGB(0,0,0) then b.BackgroundColor3=col end; b.BackgroundTransparency=tr
		end end
	end
	local function UpdatePropeller(dt)
		if not Crosshair.enabled or Crosshair.style~="Propeller" then return end
		if not Crosshair.propFrame or not Crosshair.propFrame.Parent then CreatePropeller(); return end
		local vp=camera.ViewportSize; local sz=Crosshair.size; local th=Crosshair.thick; local halfW=sz*4+sz*2+th*2
		Crosshair.propFrame.Position=UDim2.new(0,vp.X/2-halfW,0,vp.Y/2-halfW)
		if Crosshair.propSpeed>0 then Crosshair.propAngle=(Crosshair.propAngle+Crosshair.propSpeed*dt)%360 end
		Crosshair.propFrame.Rotation=Crosshair.propAngle
		if Crosshair.rainbow then Crosshair.color=Color3.fromHSV(tick()%3/3,0.9,1); UpdatePropellerColors() end
	end
	local function DestroyCH()
		if Crosshair.propFrame and Crosshair.propFrame.Parent then Crosshair.propFrame:Destroy(); Crosshair.propFrame=nil; Crosshair.propBlades={} end
		for _,o in ipairs(Crosshair.guiLines) do
			if typeof(o)=="Instance" and o.Parent then o:Destroy()
			elseif type(o)=="table" then for _,s in ipairs(o) do if typeof(s)=="Instance" and s.Parent then s:Destroy() end end end
		end
		Crosshair.guiLines={}; CHContainer.Visible=false
	end
	local function BuildCH()
		DestroyCH(); if not Crosshair.enabled then return end; CHContainer.Visible=true
		if Crosshair.style=="Propeller" then CreatePropeller(); return end
		local vp=camera.ViewportSize; local cx,cy=vp.X/2,vp.Y/2; local col=Crosshair.color
		local sz=Crosshair.size; local gap=Crosshair.gap; local th=Crosshair.thick; local tr=1-Crosshair.opacity
		local function AL(x1,y1,x2,y2)
			if Crosshair.outline then local o=MakeGUILine(x1,y1,x2,y2,Color3.fromRGB(0,0,0),th+2,tr); if o then table.insert(Crosshair.guiLines,o) end end
			local l=MakeGUILine(x1,y1,x2,y2,col,th,tr); if l then table.insert(Crosshair.guiLines,l) end
		end
		local function AC(x,y,r,filled)
			if Crosshair.outline then local o=MakeGUICircle(x,y,r+1,Color3.fromRGB(0,0,0),th+1,filled,tr); if o then table.insert(Crosshair.guiLines,o) end end
			local c2=MakeGUICircle(x,y,r,col,th,filled,tr); if c2 then table.insert(Crosshair.guiLines,c2) end
		end
		local st=Crosshair.style
		if st=="Dot" then AC(cx,cy,th,true)
		elseif st=="Cross" then AL(cx-gap-sz,cy,cx-gap,cy); AL(cx+gap,cy,cx+gap+sz,cy); AL(cx,cy-gap-sz,cx,cy-gap); AL(cx,cy+gap,cx,cy+gap+sz)
		elseif st=="Circle" then AC(cx,cy,sz,false)
		elseif st=="Dynamic" then
			local spd=0; if humanoid then spd=humanoid.MoveDirection.Magnitude*(humanoid.WalkSpeed or 16) end; local dg=gap+spd*0.3
			AL(cx-dg-sz,cy,cx-dg,cy); AL(cx+dg,cy,cx+dg+sz,cy); AL(cx,cy-dg-sz,cx,cy-dg); AL(cx,cy+dg,cx,cy+dg+sz); AC(cx,cy,th,true)
		elseif st=="T-Shape" then AL(cx-gap-sz,cy,cx-gap,cy); AL(cx+gap,cy,cx+gap+sz,cy); AL(cx,cy-gap-sz,cx,cy-gap)
		end
		Crosshair.lastStyle=st; Crosshair.lastSize=sz; Crosshair.lastGap=gap; Crosshair.lastThick=th
	end
	local function UpdateCHColors()
		for _,o in ipairs(Crosshair.guiLines) do
			if typeof(o)=="Instance" and o.Parent then
				if o.BackgroundColor3~=Color3.fromRGB(0,0,0) then o.BackgroundColor3=Crosshair.color end
				o.BackgroundTransparency=1-Crosshair.opacity
			elseif type(o)=="table" then
				for _,s in ipairs(o) do
					if typeof(s)=="Instance" and s.Parent then
						if s.BackgroundColor3~=Color3.fromRGB(0,0,0) then s.BackgroundColor3=Crosshair.color end
						s.BackgroundTransparency=1-Crosshair.opacity
					end
				end
			end
		end
	end
	local chRT=0
	function UpdateCH(dt)
		if not Crosshair.enabled then if CHContainer.Visible then DestroyCH() end; return end
		if Crosshair.style=="Propeller" then UpdatePropeller(dt); return end
