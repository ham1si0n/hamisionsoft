					distLabel.BackgroundTransparency=1; distLabel.Text="[0M]"; distLabel.TextColor3=s.distColor; distLabel.TextStrokeTransparency=0.3
					distLabel.TextSize=s.textSize-2; distLabel.Font=PIXEL_FONT; distLabel.Parent=bb
					distLabel.TextStrokeColor3 = Color3.fromRGB(0,0,0)
