function ConfigSystem.RegisterToggle(key,setFn) ConfigSystem.setStateCallbacks[key]=setFn end
function ConfigSystem.RegisterSlider(key,setFn) ConfigSystem.sliderSetCallbacks[key]=setFn end

function ConfigSystem._applyGeneral(cfg)
	if cfg.theme and Themes[cfg.theme] then ApplyTheme(cfg.theme) end
	if cfg.guiOpacity then State.guiOpacity = cfg.guiOpacity end
	if cfg.blurStrength then State.blurStrength = cfg.blurStrength end
	if cfg.toggleMenuKey then
		local ok, kc = pcall(function() return Enum.KeyCode[cfg.toggleMenuKey] end)
		if ok and kc then
			State.toggleMenuKey = kc
			if menuKeyBtn then menuKeyBtn.Text = kc.Name; menuKeyBtn.BackgroundColor3 = C.Green end
		end
	end
	if cfg.fakeLagEnabled ~= nil then State.fakeLagEnabled = cfg.fakeLagEnabled end
	if cfg.autoJumpEnabled ~= nil then State.autoJumpEnabled = cfg.autoJumpEnabled end
	if cfg.autoJumpInterval ~= nil then State.autoJumpInterval = cfg.autoJumpInterval end
	if cfg.esp360Enabled ~= nil then State.esp360Enabled = cfg.esp360Enabled end
	if cfg.cameraNoclipEnabled ~= nil then
		State.cameraNoclipEnabled = cfg.cameraNoclipEnabled
		if cfg.cameraNoclipEnabled then StartCameraNoclip() else StopCameraNoclip() end
	end
end

function ConfigSystem._applySliders(cfg)
	local map = {
		speed={val=cfg.speedValue,state="speedValue"},
		jump={val=cfg.jumpValue,state="jumpValue"},
		gravity={val=cfg.gravityValue,state="gravityValue"},
		flySpeed={val=cfg.flySpeed,state="flySpeed"},
		spinSpeed={val=cfg.spinSpeed,state="spinSpeed"},
		fov={val=cfg.fovValue,state="fovValue"},
		killAuraRadius={val=cfg.killAuraRadius,state="killAuraRadius"},
		espColorR={val=cfg.espColorR,state="espColorR"},
		espColorG={val=cfg.espColorG,state="espColorG"},
		espColorB={val=cfg.espColorB,state="espColorB"},
	}
	for key, info in pairs(map) do
		if info.val ~= nil then
			State[info.state] = info.val
			if ConfigSystem.sliderSetCallbacks[key] then ConfigSystem.sliderSetCallbacks[key](info.val) end
		end
	end
end

