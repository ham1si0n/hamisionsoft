do
	local function UpdateSpin()
		if State.spinEnabled and rootPart and not State.flyEnabled then
			State.spinAngle=State.spinAngle+math.rad(State.spinSpeed)
			rootPart.CFrame=CFrame.new(rootPart.Position)*CFrame.Angles(0,State.spinAngle,0)
		end
	end
	local function UpdateAttach()
		if State.attachBehindEnabled and State.attachBehindTarget then
			local tc=State.attachBehindTarget.Character
			if tc and tc:FindFirstChild("HumanoidRootPart") and rootPart then rootPart.CFrame=tc.HumanoidRootPart.CFrame*CFrame.new(0,0,2)
			else State.attachBehindEnabled=false; State.attachBehindTarget=nil end
		end
		if State.attachHeadEnabled and State.attachHeadTarget then
			local tc=State.attachHeadTarget.Character
			if tc and tc:FindFirstChild("Head") and rootPart and humanoid then rootPart.CFrame=tc.Head.CFrame*CFrame.new(0,1.5,0); humanoid.Sit=true
			else State.attachHeadEnabled=false; State.attachHeadTarget=nil; if humanoid then humanoid.Sit=false end end
		end
		if State.attachFeetEnabled and State.attachFeetTarget then
			local tc=State.attachFeetTarget.Character
			if tc and tc:FindFirstChild("HumanoidRootPart") and rootPart then rootPart.CFrame=tc.HumanoidRootPart.CFrame*CFrame.new(0,-3,0)*CFrame.Angles(math.rad(90),0,0)
			else State.attachFeetEnabled=false; State.attachFeetTarget=nil end
		end
	end
	RunService.Heartbeat:Connect(function()
		UpdateFly(); UpdateAttach(); UpdateSpin()
	end)
	State.Rejoin = function()
		ShowNotification("Rejoining...", C.Yellow, 2)
		task.wait(1)
		local ts = game:GetService("TeleportService")
		ts:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
	end
end

