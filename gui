-- === ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ===
local function CreateDashedBorder(parent)
    local dashContainer = Instance.new("Frame")
    dashContainer.Size = UDim2.new(1,-4,1,-4)
    dashContainer.Position = UDim2.new(0,2,0,2)
    dashContainer.BackgroundTransparency = 1
    dashContainer.BorderSizePixel = 0
    dashContainer.ZIndex = 10
    dashContainer.ClipsDescendants = false
    dashContainer.Parent = parent
    local dashes = {}
    local dashLen = 8
    local gapLen = 5
    local thick = 2
    for i=0,50 do
        local d = Instance.new("Frame")
        d.Size = UDim2.new(0,dashLen,0,thick)
        d.Position = UDim2.new(0,i*(dashLen+gapLen),0,-1)
        d.BackgroundColor3 = C.DashColor
        d.BackgroundTransparency = 0.3
        d.BorderSizePixel = 0
        d.ZIndex = 11
        d.Parent = dashContainer
        table.insert(dashes, d)
    end
    for i=0,50 do
        local d = Instance.new("Frame")
        d.Size = UDim2.new(0,dashLen,0,thick)
        d.Position = UDim2.new(0,i*(dashLen+gapLen),1,-1)
        d.BackgroundColor3 = C.DashColor
        d.BackgroundTransparency = 0.3
        d.BorderSizePixel = 0
        d.ZIndex = 11
        d.Parent = dashContainer
        table.insert(dashes, d)
    end
    for i=0,50 do
        local d = Instance.new("Frame")
        d.Size = UDim2.new(0,thick,0,dashLen)
        d.Position = UDim2.new(0,-1,0,i*(dashLen+gapLen))
        d.BackgroundColor3 = C.DashColor
        d.BackgroundTransparency = 0.3
        d.BorderSizePixel = 0
        d.ZIndex = 11
        d.Parent = dashContainer
        table.insert(dashes, d)
    end
    for i=0,50 do
        local d = Instance.new("Frame")
        d.Size = UDim2.new(0,thick,0,dashLen)
        d.Position = UDim2.new(1,-1,0,i*(dashLen+gapLen))
        d.BackgroundColor3 = C.DashColor
        d.BackgroundTransparency = 0.3
        d.BorderSizePixel = 0
        d.ZIndex = 11
        d.Parent = dashContainer
        table.insert(dashes, d)
    end
    return dashContainer, dashes
end

local function CreateStarfield(parent, count)
    count = count or 60
    for i=1,count do
        local star = Instance.new("Frame")
        star.Size = UDim2.new(0,math.random(2,5),0,math.random(2,5))
        star.Position = UDim2.new(math.random(0,100)/100,0,math.random(0,100)/100,0)
        star.BackgroundColor3 = Color3.fromRGB(255,255,255)
        star.BackgroundTransparency = 0.8
        star.BorderSizePixel = 0
        star.ZIndex = 0
        star.Parent = parent
        Instance.new("UICorner", star).CornerRadius = UDim.new(1,0)
        task.spawn(function()
            while star and star.Parent do
                local duration = math.random(2,6)
                local targetTrans = math.random(3,8)/10
                TweenService:Create(star, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                    BackgroundTransparency = targetTrans,
                    Size = UDim2.new(0,math.random(2,5),0,math.random(2,5))
                }):Play()
                task.wait(duration)
                TweenService:Create(star, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                    BackgroundTransparency = 0.8,
                    Size = UDim2.new(0,math.random(2,5),0,math.random(2,5))
                }):Play()
                task.wait(duration)
            end
        end)
    end
end

local function MakeDraggable(handle, target)
    local drag, dragStart, startPos = false, nil, nil
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true
            dragStart = i.Position
            startPos = target.Position
        end
    end)
    handle.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = i.Position - dragStart
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                        startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

