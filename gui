	if State.flyToggleButtonEnabled and State.flyToggleKey and input.KeyCode==State.flyToggleKey then
		State.flyEnabled = not State.flyEnabled
		if State.flyEnabled then StartFly() else StopFly() end
		if State.UpdateFlyMiniStatus then State.UpdateFlyMiniStatus() end
