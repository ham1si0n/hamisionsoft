function ConfigSystem.GetProfiles()
	local p = {}
	if not hasFileSystem then return p end
	pcall(function()
		if isfolder(CONFIG_FOLDER) then
			for _, f in ipairs(listfiles(CONFIG_FOLDER)) do
				local n = f:match("([^/\\]+)%.json$")
				if n and n ~= "_meta" then table.insert(p, n) end
			end
		end
	end)
	table.sort(p)
	return p
end

function ConfigSystem.SaveLastProfile(name)
	if not hasFileSystem then return end
	pcall(function() writefile(CONFIG_FOLDER.."/_last.txt", name) end)
end

-- Auto-load only if the last saved profile was saved on THIS place.
function ConfigSystem.LoadLastProfile()
	if not hasFileSystem then return nil end
	local ok, name = pcall(function()
		if isfile(CONFIG_FOLDER.."/_last.txt") then return readfile(CONFIG_FOLDER.."/_last.txt") end
	end)
	if not ok or not name or name == "" then return nil end
	if not isfile(ConfigSystem.ProfilePath(name)) then return nil end
	local meta = ConfigSystem.GetProfileMeta(name)
	if not meta or not meta.gameId or meta.gameId ~= game.PlaceId then
		return nil
	end
	return name
end

function ConfigSystem.SaveToFile(name)
	if not hasFileSystem then return false,"No filesystem" end
	if not isfolder(CONFIG_FOLDER) then pcall(makefolder,CONFIG_FOLDER) end
	local cfg = ConfigSystem.GatherConfig()
	cfg._meta = {
		name = name,
		version = SCRIPT_VERSION,
		savedAt = os.time(),
		gameId = game.PlaceId,
	}
	pcall(function()
		local info = MarketplaceService:GetProductInfo(game.PlaceId)
		cfg._meta.gameName = info and info.Name or "Unknown"
	end)
	local ok,err = pcall(function() writefile(ConfigSystem.ProfilePath(name), HttpService:JSONEncode(cfg)) end)
	if ok then
		ConfigSystem.currentProfile = name
		ConfigSystem.SaveLastProfile(name)
		return true, "Saved: "..name
	end
	return false, "Error: "..tostring(err)
end

function ConfigSystem.LoadFromFile(name)
	if not hasFileSystem then return false,"No filesystem" end
	local path = ConfigSystem.ProfilePath(name)
	if not pcall(function() assert(isfile(path)) end) then return false,"Not found: "..name end
	local cfg
	if not pcall(function() cfg=HttpService:JSONDecode(readfile(path)) end) then return false,"Parse error" end
	if ConfigSystem.ApplyConfig(cfg) then
		ConfigSystem.currentProfile = name
		ConfigSystem.SaveLastProfile(name)
		return true, "Loaded: "..name
	end
	return false, "Apply error"
end

function ConfigSystem.DeleteProfile(name)
	if not hasFileSystem then return false,"No filesystem" end
	pcall(function() if isfile(ConfigSystem.ProfilePath(name)) then delfile(ConfigSystem.ProfilePath(name)) end end)
	if ConfigSystem.currentProfile == name then ConfigSystem.currentProfile = "default" end
	return true, "Deleted: "..name
end

