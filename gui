				Position = UDim2.new(0.5, 180, 0.5, -230)
			}):Play()
			task.wait(0.3); UpdatePL()
		else
			TweenService:Create(PLFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
				Size = UDim2.new(0, State.playersMenuSize.Width*0.5, 0, State.playersMenuSize.Height*0.5),
				Position = UDim2.new(0.5, 180-State.playersMenuSize.Width*0.25, 0.5, -230+State.playersMenuSize.Height*0.25)
			}):Play()
			task.delay(0.4, function() PLFrame.Visible = false; PLFrame.Size = UDim2.new(0, State.playersMenuSize.Width, 0, State.playersMenuSize.Height) end)
		end
	end
	GUI.ClosePlayers = function()
		plVisible=false
		PLFrame.Visible=false
		PLFrame.Size = UDim2.new(0, State.playersMenuSize.Width, 0, State.playersMenuSize.Height)
	end
	GUI.UpdatePL = UpdatePL
end

