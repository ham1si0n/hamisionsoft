	local esp360Container = nil
	local esp360Pool = {}
	local esp360Active = {}

	function SetupESP360()
		if esp360Container and esp360Container.Parent then esp360Container:Destroy() end
		esp360Pool = {}; esp360Active = {}
		esp360Container = Instance.new("Frame")
		esp360Container.Name = "ESP360"
		esp360Container.Size = UDim2.new(1,0,1,0)
		esp360Container.Position = UDim2.new(0,0,0,0)
		esp360Container.BackgroundTransparency = 1
		esp360Container.ZIndex = 50
