-- ================= BLOCK: AIMBOT =================
do
	local function EnsureAimbotFovCircle()
		if Aimbot.fovCircle then return true end
		local ok, circle = pcall(function()
			local c = Drawing.new("Circle")
			c.Visible = false; c.Radius = Aimbot.fov
			c.Color = Color3.fromRGB(255, 255, 255); c.Thickness = 1.5
			c.Transparency = 0.5; c.Filled = false
			return c
		end)
		if ok then Aimbot.fovCircle = circle; return true else return false end
	end
	local function IsVisible(part)
		if not Aimbot.visCheck then return true end
		if not rootPart then return false end
		local origin = rootPart.Position + Vector3.new(0, 2, 0)
		local params = RaycastParams.new()
		params.FilterDescendantsInstances = {character, part.Parent}
		params.FilterType = Enum.RaycastFilterType.Exclude
		return workspace:Raycast(origin, (part.Position - origin), params) == nil
	end
	local function GetTarget()
		if not Aimbot.enabled then return nil end
		local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
		local cd = Aimbot.fov; local ct = nil
		for _, target in pairs(Players:GetPlayers()) do
			if target ~= player then
				local teamCheck = Aimbot.teamCheck and target.Team == player.Team and player.Team ~= nil
				if not teamCheck and not IsImmortal(target) then
					local ch = target.Character
					if ch then
						local part = ch:FindFirstChild(Aimbot.targetPart) or ch:FindFirstChild("Head")
						if part then
							local h2 = ch:FindFirstChild("Humanoid")
							if h2 and h2.Health > 0 then
								local sp, on = camera:WorldToViewportPoint(part.Position)
								if on and IsVisible(part) then
									local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
									if dist < cd then cd = dist; ct = target end
								end
							end
						end
					end
				end
			end
		end
		return ct
	end
	function Aimbot.Update(dt)
		if not EnsureAimbotFovCircle() then return end
		if Aimbot.fovCircle then
			local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
			Aimbot.fovCircle.Position = center
			Aimbot.fovCircle.Radius = Aimbot.fov
			Aimbot.fovCircle.Visible = Aimbot.fovVisible and Aimbot.enabled
		end
		if not Aimbot.enabled then return end
		local kp = false
		if typeof(Aimbot.key) == "EnumItem" and Aimbot.key.EnumType == Enum.KeyCode then
			kp = UserInputService:IsKeyDown(Aimbot.key)
		else
			pcall(function() kp = UserInputService:IsMouseButtonPressed(Aimbot.key) end)
		end
		if not kp then
			Aimbot.locked = nil
			if Aimbot.statusLabel then Aimbot.statusLabel.Text = "TARGET: NONE"; Aimbot.statusLabel.TextColor3 = C.TextDim end
			return
		end
		if Aimbot.locked then
			local ch = Aimbot.locked.Character
			local part = ch and (ch:FindFirstChild(Aimbot.targetPart) or ch:FindFirstChild("Head"))
			if not part or not ch:FindFirstChild("Humanoid") or ch.Humanoid.Health <= 0 then Aimbot.locked = nil end
		end
		if not Aimbot.locked then Aimbot.locked = GetTarget() end
		if Aimbot.locked then
			local ch = Aimbot.locked.Character
			local part = ch and (ch:FindFirstChild(Aimbot.targetPart) or ch:FindFirstChild("Head"))
			if not part then Aimbot.locked = nil; return end
			local tp = part.Position
			if Aimbot.prediction then
				local r = ch:FindFirstChild("HumanoidRootPart")
				if r then tp = tp + r.AssemblyLinearVelocity * Aimbot.predictAmount end
			end
			local _, on = camera:WorldToViewportPoint(tp)
			if on then
				local lf = math.clamp(Aimbot.smooth * (dt or 0.016) * 60, 0, 1)
				camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, tp), lf)
				if Aimbot.statusLabel and rootPart then
					local dist = math.floor((rootPart.Position - part.Position).Magnitude)
					Aimbot.statusLabel.Text = "TARGET: " .. Aimbot.locked.DisplayName .. " [" .. dist .. "M]"
					Aimbot.statusLabel.TextColor3 = C.Red
				end
			end
		else
			if Aimbot.statusLabel then Aimbot.statusLabel.Text = "SEARCHING..."; Aimbot.statusLabel.TextColor3 = C.Orange end
		end
	end

	local aimbotScroll,ToggleAimbotMenu=MakeSubMenu("AIMBOT",C.Red,State.aimbotMenuSize.Width,State.aimbotMenuSize.Height,"aimbotMenuSize")
