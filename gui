            label.Font = Enum.Font.Arcade
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = frame

            local keyBtn = Instance.new("TextButton")
            keyBtn.Size = UDim2.new(0,80,0,26)
            keyBtn.Position = UDim2.new(1,-90,0.5,-13)
            keyBtn.BackgroundColor3 = C.BackgroundMid
            keyBtn.BackgroundTransparency = 0.3
            keyBtn.Text = default and default.Name or "NONE"
            keyBtn.TextColor3 = C.Text
            keyBtn.TextSize = 10
            keyBtn.Font = Enum.Font.Arcade
            keyBtn.BorderSizePixel = 0
            keyBtn.Parent = frame
            Instance.new("UICorner", keyBtn).CornerRadius = UDim.new(0,5)

            local waiting = false
            keyBtn.MouseButton1Click:Connect(function()
                if waiting then return end
                waiting = true
                keyBtn.Text = "..."
                keyBtn.BackgroundColor3 = C.Orange
                local conn
                conn = UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        local key = input.KeyCode
                        keyBtn.Text = key.Name
                        keyBtn.BackgroundColor3 = C.Green
                        callback(key)
                        waiting = false
                        conn:Disconnect()
                    end
                end)
            end)

            return keyBtn, function(key)
                keyBtn.Text = key and key.Name or "NONE"
                keyBtn.BackgroundColor3 = C.Green
            end
        end

        return tab
    end

    return window
end

return GUI
