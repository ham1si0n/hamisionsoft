	function RefreshESP()
		for t2,_ in pairs(ESP.objects) do RemoveESP(t2) end
		if State.espEnabled then
			for _,t2 in pairs(Players:GetPlayers()) do if t2~=player then CreateESP(t2) end end
		end
		if State.esp360Enabled then UpdateESP360() end
	end
	local espUT=0
	function UpdateESP(dt)
		if not State.espEnabled then
			for _,obj in pairs(ESP.objects) do
				if obj.tracerLine then pcall(function() obj.tracerLine.Visible=false end) end
				if obj.skeleton then for _, line in pairs(obj.skeleton) do pcall(function() line.Visible = false end) end end
				if obj.bb then obj.bb.Enabled = false end
				if obj.box then obj.box.Enabled = false end
			end
			if State.esp360Enabled and esp360Container then esp360Container.Visible = false end
			return
		end
		if State.esp360Enabled then UpdateESP360()
		elseif esp360Container then esp360Container.Visible = false end
		espUT=espUT+dt; local ud=espUT>=0.1; if ud then espUT=0 end
		local originPt=GetTracerOriginPoint(); local myPos=rootPart and rootPart.Position or Vector3.zero
		for target,obj in pairs(ESP.objects) do
			if obj.root and obj.root.Parent then
				local tp=obj.root.Position; local dist=(myPos-tp).Magnitude
				local withinRange = dist <= ESP.settings.maxDistance
				if obj.bb then
					obj.bb.Enabled = withinRange and (ESP.settings.showNames or ESP.settings.showDistance)
					if obj.bb.Enabled and ud and obj.distLabel and obj.distLabel.Parent then obj.distLabel.Text="["..math.floor(dist).."M]" end
				end
				if obj.box then obj.box.Enabled = withinRange and ESP.settings.showBox end
				-- Corner ESP: fixed size, no distance scaling.
				if obj.tracerLine~=nil and ESP.settings.showTracers then
					if withinRange then
						local sp,on=camera:WorldToViewportPoint(tp)
						if on then
							pcall(function() obj.tracerLine.Visible=true; obj.tracerLine.From=originPt
								obj.tracerLine.To=Vector2.new(sp.X,sp.Y); obj.tracerLine.Color=ESP.settings.tracerColor end)
						else pcall(function() obj.tracerLine.Visible=false end) end
					else pcall(function() obj.tracerLine.Visible=false end) end
				elseif obj.tracerLine~=nil then pcall(function() obj.tracerLine.Visible=false end) end
				if ESP.settings.showSkeleton and obj.skeleton then UpdateSkeleton(target, obj) end
			else
				task.defer(function() RemoveESP(target) end)
			end
		end
	end
	task.spawn(function() while State.guiEnabled do
		if State.espEnabled then
			for _,t2 in pairs(Players:GetPlayers()) do
				if t2~=player then
					local ch=t2.Character
					if ch then
