	end

	-- Corner defs: sx/sy = scale anchor, ox/oy = base pixel offset, w/h = base pixel size.
	-- Corner ESP is FIXED pixel size (no distance scaling) to avoid "swelling" into white crosses.
	local cornerDefs = {
		{sx=0, sy=0, ox=0,   oy=0,   w=8, h=2}, -- TL horizontal
		{sx=0, sy=0, ox=0,   oy=0,   w=2, h=8}, -- TL vertical
		{sx=1, sy=0, ox=-8,  oy=0,   w=8, h=2}, -- TR horizontal
		{sx=1, sy=0, ox=-2,  oy=0,   w=2, h=8}, -- TR vertical
		{sx=0, sy=1, ox=0,   oy=-2,  w=8, h=2}, -- BL horizontal
		{sx=0, sy=1, ox=0,   oy=-8,  w=2, h=8}, -- BL vertical
		{sx=1, sy=1, ox=-8,  oy=-2,  w=8, h=2}, -- BR horizontal
		{sx=1, sy=1, ox=-2,  oy=-8,  w=2, h=8}, -- BR vertical
	}

	local function CreateBox(adornee, color)
		local boxGui = Instance.new("BillboardGui")
		boxGui.Name = "ESPBox"; boxGui.Adornee = adornee
		boxGui.Size = UDim2.new(4, 0, 5.5, 0)
		boxGui.AlwaysOnTop = true; boxGui.MaxDistance = ESP.settings.maxDistance; boxGui.Parent = adornee
		local frame = Instance.new("Frame"); frame.Size = UDim2.new(1, 0, 1, 0); frame.BackgroundTransparency = 1; frame.Parent = boxGui
		local style = ESP.settings.boxStyle
		local cornerRefs = nil
		if style == "Outline" then
			local lines = {
				{UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, 2)},
				{UDim2.new(0, 0, 1, -2), UDim2.new(1, 0, 0, 2)},
				{UDim2.new(0, 0, 0, 0), UDim2.new(0, 2, 1, 0)},
				{UDim2.new(1, -2, 0, 0), UDim2.new(0, 2, 1, 0)}
			}
			for _, d in pairs(lines) do
				local line = Instance.new("Frame"); line.Name = "BoxLine"
				line.Position = d[1]; line.Size = d[2]; line.BackgroundColor3 = color; line.BorderSizePixel = 0; line.Parent = frame
			end
		elseif style == "Filled" then
			local fill = Instance.new("Frame"); fill.Size = UDim2.new(1, 0, 1, 0)
			fill.BackgroundColor3 = color; fill.BackgroundTransparency = ESP.settings.fillTransparency
			fill.BorderSizePixel = 0; fill.Parent = frame
		elseif style == "Corner" then
			cornerRefs = {}
			for _, def in ipairs(cornerDefs) do
				local cf = Instance.new("Frame")
				cf.Position = UDim2.new(def.sx, def.ox, def.sy, def.oy)
				cf.Size = UDim2.new(0, def.w, 0, def.h)
				cf.BackgroundColor3 = color; cf.BorderSizePixel = 0; cf.Parent = frame
				table.insert(cornerRefs, {frame=cf})
			end
		end
		return boxGui, frame, cornerRefs
	end
