local function setupDeathListener(plr)
	local function connectDied(char)
		local hum = char:WaitForChild("Humanoid")
		hum.Died:Connect(function()
			if not State.notificationsEnabled then return end
			local killer = nil
			pcall(function()
				local creatorTag = hum:FindFirstChild("creator")
				if creatorTag and creatorTag:IsA("ObjectValue") and creatorTag.Value and creatorTag.Value:IsA("Player") then killer = creatorTag.Value
				else
					local la = hum:GetAttribute("LastAttacker")
					if la then
						if typeof(la) == "Instance" and la:IsA("Player") then killer = la
						elseif typeof(la) == "string" then killer = Players:FindFirstChild(la) end
					end
				end
			end)
			if killer == plr and plr ~= player then ShowNotification("Killed "..plr.DisplayName, C.Red, 3)
			elseif plr == player then
				if killer and killer ~= player then ShowNotification("Killed by "..killer.DisplayName, C.Orange, 3)
				else ShowNotification("You died", C.Orange, 3) end
			end
		end)
	end
	if plr.Character then connectDied(plr.Character) end
	plr.CharacterAdded:Connect(connectDied)
end
for _, plr in pairs(Players:GetPlayers()) do if plr ~= player then setupDeathListener(plr) end end
Players.PlayerAdded:Connect(setupDeathListener)

