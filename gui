-- ================= MENU OPEN/CLOSE =================
local function ToggleMenu()
	if State.menuAnimating then return end
	State.guiOpen = not State.guiOpen
	if State.guiOpen then
		IconButton.Visible = false
		MainContainer.Position = UDim2.new(IconButton.Position.X.Scale, IconButton.Position.X.Offset, IconButton.Position.Y.Scale, IconButton.Position.Y.Offset)
		MainContainer.Size = UDim2.new(0, 60, 0, 60)
		MainContainer.Visible = true
		State.menuAnimating = true
		local tween = TweenService:Create(MainContainer, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, State.mainMenuSize.Width, 0, State.mainMenuSize.Height)
		})
		tween:Play()
		tween.Completed:Connect(function() State.menuAnimating = false end)
	else
		CloseAllSubMenus()
		GUI.ClosePlayers()
		if State.ToggleFlyMini then State.ToggleFlyMini(false) end
		State.menuAnimating = true
		local ip = IconButton.Position
		local tween = TweenService:Create(MainContainer, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 60, 0, 60),
			Position = UDim2.new(ip.X.Scale, ip.X.Offset, ip.Y.Scale, ip.Y.Offset)
		})
		tween:Play()
		tween.Completed:Connect(function()
			MainContainer.Visible = false
			MainContainer.Size = UDim2.new(0, State.mainMenuSize.Width, 0, State.mainMenuSize.Height)
			IconButton.Visible = true; IconButton.ImageTransparency = 0
			State.menuAnimating = false
		end)
	end
end

