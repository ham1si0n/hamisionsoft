        Lighting.Brightness = 0.8
        Lighting.Ambient = Color3.fromRGB(70,65,90)
        Lighting.OutdoorAmbient = Color3.fromRGB(60,55,85)
        Lighting.FogColor = Color3.fromRGB(25,20,35)
