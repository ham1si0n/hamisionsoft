-- ---- FULLBRIGHT ----
local origBrightness, origClockTime, origFogEnd, origGlobalShadows
local function ToggleFullbright(enabled)
    State.fullbrightEnabled = enabled
    if enabled then
        origBrightness = Lighting.Brightness
        origClockTime = Lighting.ClockTime
        origFogEnd = Lighting.FogEnd
        origGlobalShadows = Lighting.GlobalShadows
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
    else
        Lighting.Brightness = origBrightness
        Lighting.ClockTime = origClockTime
        Lighting.FogEnd = origFogEnd
        Lighting.GlobalShadows = origGlobalShadows
    end
end

-- ---- NIGHT ----
local nightOrigClockTime, nightOrigBrightness, nightOrigAmbient, nightOrigOutdoorAmbient, nightOrigFogColor, nightOrigFogEnd
local function ToggleNight(enabled)
    State.nightEnabled = enabled
    if enabled then
        nightOrigClockTime = Lighting.ClockTime
        nightOrigBrightness = Lighting.Brightness
