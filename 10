-- ---- FAKE LAG ----
local fakeLagConnection
local function ToggleFakeLag(enabled)
    State.fakeLagEnabled = enabled
    if enabled then
        fakeLagConnection = RunService.Heartbeat:Connect(function()
            if State.fakeLagEnabled and humanoid then
                humanoid.WalkSpeed = 0
                task.wait(0.1)
                if humanoid then humanoid.WalkSpeed = State.speedValue end
            end
        end)
    else
        if fakeLagConnection then fakeLagConnection:Disconnect(); fakeLagConnection = nil end
        if humanoid then humanoid.WalkSpeed = State.speedValue end
    end
end

-- ---- AUTO SPEED ----
local function ToggleAutoSpeed(enabled)
    State.autoSpeedEnabled = enabled
    if enabled then
        task.spawn(function()
            while State.autoSpeedEnabled and humanoid do
                humanoid.WalkSpeed = State.speedValue
                task.wait(0.2)
            end
        end)
    end
end

-- ---- AUTO JUMP ----
local function ToggleAutoJump(enabled)
    State.autoJumpEnabled = enabled
    if enabled then
        task.spawn(function()
            while State.autoJumpEnabled and humanoid do
                if State.autoJumpInterval > 0 and humanoid:GetState() ~= Enum.HumanoidStateType.Dead then
                    local state = humanoid:GetState()
                    if state == Enum.HumanoidStateType.Landed or state == Enum.HumanoidStateType.Running then
                        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                    end
                end
                task.wait(State.autoJumpInterval)
            end
        end)
    end
end
local function SetAutoJumpInterval(v) State.autoJumpInterval = v end

